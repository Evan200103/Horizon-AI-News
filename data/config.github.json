{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "temperature": 0.2,
    "max_tokens": 4096,
    "throttle_sec": 0.5,
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2,
    "languages": ["zh"]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": { "threshold": 7.5, "topic_dedup": true },
      "tech-blog": { "threshold": 7.0, "topic_dedup": true },
      "finance-news": { "threshold": 8.0, "topic_dedup": true }
    }
  },
  "display": { "icon_style": "emoji" },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 25,
      "min_score": 120,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-analysis",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "open-source-ai",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google Blog",
        "url": "https://blog.google/feed/",
        "enabled": true,
        "category": "ai-products",
        "profile": "tech-news"
      },
      {
        "name": "NVIDIA Technical Blog",
        "url": "https://developer.nvidia.com/blog/feed/",
        "enabled": true,
        "category": "ai-infrastructure",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "MachineLearning", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 50, "profile": "tech-news" },
        { "subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 50, "profile": "tech-news" },
        { "subreddit": "artificial", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 8, "min_score": 60, "profile": "tech-news" }
      ],
      "users": [],
      "fetch_comments": 8
    },
    "github": [
      { "type": "repo_releases", "owner": "openai", "repo": "openai-python", "enabled": true, "profile": "tech-news" },
      { "type": "repo_releases", "owner": "anthropics", "repo": "anthropic-sdk-python", "enabled": true, "profile": "tech-news" },
      { "type": "repo_releases", "owner": "huggingface", "repo": "transformers", "enabled": true, "profile": "tech-news" },
      { "type": "repo_releases", "owner": "ollama", "repo": "ollama", "enabled": true, "profile": "tech-news" },
      { "type": "repo_releases", "owner": "vllm-project", "repo": "vllm", "enabled": true, "profile": "tech-news" },
      { "type": "repo_releases", "owner": "langchain-ai", "repo": "langchain", "enabled": true, "profile": "tech-news" }
    ],
    "telegram": { "enabled": false, "channels": [] },
    "twitter": { "enabled": false, "users": [], "fetch_limit": 10, "fetch_reply_text": false, "max_replies_per_tweet": 3, "max_tweets_to_expand": 10, "reply_min_likes": 5, "profile": "tech-news" },
    "openbb": { "enabled": false, "fetch_filings": false, "filings_provider": "sec", "watchlists": [] },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["Python", "TypeScript"],
      "keywords": ["AI", "LLM", "agent", "RAG", "multimodal"],
      "min_stars": 50,
      "max_items": 10,
      "profile": "tech-news"
    },
    "gdelt": { "enabled": false, "query": "artificial intelligence", "mode": "ArtList", "max_records": 50, "timespan": null, "language": null, "country": null, "category": "ai-industry", "profile": "tech-news" },
    "google_news": {
      "enabled": true,
      "query": "artificial intelligence OR OpenAI OR Anthropic OR Gemini OR Claude OR 大模型 OR 人工智能",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 30,
      "category": "ai-industry",
      "profile": "tech-news"
    }
  },
  "collection": { "time_window_hours": 24 },
  "digest": {
    "max_items": 12,
    "profile_order": ["tech-news", "tech-blog", "finance-news"],
    "category_groups": {
      "model-and-product": { "limit": 4, "categories": ["ai-products", "open-source-ai"] },
      "engineering": { "limit": 4, "categories": ["ai-infrastructure", "ai-analysis"] },
      "industry": { "limit": 4, "categories": ["ai-industry"] }
    },
    "default_group": "community",
    "default_group_limit": 4
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": ["zh"],
    "headers": ""
  }
}
